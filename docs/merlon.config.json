{
  "configVersion": "1.1.0",
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": ["features", "client", "developer", "glossary"],
  "banner": "<!-- AUTO-GENERATED by Merlon Docs — edit shards, then run: merlon compile -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "client",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "glossary",
      "compile": {}
    }
  ],
  "standaloneGuides": [],
  "scan": {
    "strict": true,
    "ignore": [
      "_build/**",
      ".caches/**",
      ".tmp/**",
      ".specstory/**",
      ".agents/**",
      ".worktrees/**",
      "node_modules/**",
      "docs/**",
      "mod/**",
      "src/**",
      "tests/**",
      "scripts/**",
      "site/**",
      "AGENTS.md",
      ".github/**",
      ".changeset/**",
      ".superpowers/**",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "README.md",
      "LICENSE",
      "package.json",
      "package-lock.json",
      "skills-lock.json"
    ]
  },
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "../node_modules/@merlon-docs/merlon-docs-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "../node_modules/@merlon-docs/merlon-docs-presets/markdownlint-compiled.markdownlint-cli2.jsonc"
    }
  }
}
