<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Keeps the comment on every `using` line current: what the file takes from that namespace,
    plus a note of the game's global-namespace classes it uses. Run by scripts/import-comments.sh
    (npm run imports / npm run imports:check). Not part of the mod or the solution.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>
</Project>
