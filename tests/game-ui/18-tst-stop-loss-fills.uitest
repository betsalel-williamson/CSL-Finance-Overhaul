# Needs the dev test stock (TST) in a test save.
name a stop-loss waits above the stop, then sells at the lower daily price after a gap down
set-price TST 100
run-days 1
remember TST
show-buy TST
type FinanceOverhaulShareAmountField 10
click Button
wait 1
show-sell TST
click FinanceOverhaulOrderTab-StopLossSell
type FinanceOverhaulShareAmountField 10
type FinanceOverhaulLimitPriceField 90
click Button
expect-orders-delta 1
set-price TST 95
run-days 1
expect-orders-delta 1
expect-owned-delta TST 10
set-price TST 85
run-days 1
expect-log sold 10 FinanceOverhaul Test Stock at 85 (stop 90) for 850
expect-orders-delta 0
expect-owned-delta TST 0
cleanup:
cancel-new-orders
set-price TST 100
close-dialog
