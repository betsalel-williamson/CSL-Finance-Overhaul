# Needs the dev test stock (TST) in a test save.
name a limit buy waits while the price is above the limit, then fills
set-price TST 100
run-days 1
remember TST
show-buy TST
click FinanceOverhaulOrderTab-Limit
type FinanceOverhaulShareAmountField 5
type FinanceOverhaulLimitPriceField 90
click Button
expect-orders-delta 1
run-days 1
expect-price TST 100
expect-orders-delta 1
expect-owned-delta TST 0
set-price TST 90
run-days 1
expect-log orders: filled
expect-orders-delta 0
expect-owned-delta TST 5
cleanup:
cancel-new-orders
sell-back TST 5
set-price TST 100
close-dialog
