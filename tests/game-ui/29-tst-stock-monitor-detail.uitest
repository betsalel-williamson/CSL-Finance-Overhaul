# Needs the dev test stock (TST). UI only: no days advanced, no trades.
name clicking a Stock Monitor row opens the Invest dialog with the stock's chart, 7D/30D tabs and stats
monitor remember
monitor close
click FinanceOverhaulStockMonitorButton
wait 1
# the player's filter may be Portfolio or Orders; restored at the end
click FinanceOverhaulStockMonitorFilter-All
click FinanceOverhaulStockMonitorRow-TST
wait 1
expect-visible FinanceOverhaulOrderInfo
expect-visible FinanceOverhaulStockMonitorRows
expect-text FinanceOverhaulOrderChange (
expect-text FinanceOverhaulOrderInfoStatKey-0-1 30-day high
expect-text FinanceOverhaulShareChartFrom 30 days ago
expect-text FinanceOverhaulOrderInfoStat-1-0 none
expect-no-overflow FinanceOverhaulOrderInfo
capture stock-monitor-opens-dialog
click FinanceOverhaulOrderRange-7
wait 1
expect-text FinanceOverhaulShareChartFrom 7 days ago
expect-text FinanceOverhaulOrderInfoStatKey-0-1 7-day high
expect-no-overflow FinanceOverhaulOrderInfo
capture stock-monitor-opens-dialog-7d
click FinanceOverhaulOrderRange-30
cleanup:
close-dialog
monitor close
monitor restore
