# Needs the dev test stock (TST) in a test save.
name a trailing stop follows a new high, never moves down, then sells once the price falls to the raised stop
set-price TST 100
run-days 1
remember TST
show-buy TST
type FinanceOverhaulShareAmountField 10
click Button
wait 1
show-sell TST
click FinanceOverhaulOrderTab-TrailingStopSell
type FinanceOverhaulShareAmountField 10
type FinanceOverhaulLimitPriceField 10
click Button
expect-orders-delta 1
set-price TST 120
run-days 1
expect-log follows a new high 120 (stop 108)
expect-orders-delta 1
set-price TST 110
run-days 1
expect-orders-delta 1
expect-owned-delta TST 10
set-price TST 105
run-days 1
expect-log sold 10 FinanceOverhaul Test Stock at 105 (stop 108) for 1050
expect-orders-delta 0
expect-owned-delta TST 0
cleanup:
cancel-new-orders
set-price TST 100
close-dialog
